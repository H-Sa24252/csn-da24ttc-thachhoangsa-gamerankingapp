@model IReadOnlyList<RankedPlayer>
<h1>@ViewData["Title"]</h1>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">Hạng</th><th scope="col">Người chơi</th><th scope="col">Điểm</th>
                <th scope="col">Cấp độ</th><th scope="col">EXP</th><th scope="col">Thắng</th>
                <th scope="col">Thua</th><th scope="col">Tổng số trận</th><th scope="col">Tỷ lệ thắng</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.Rank</td><th scope="row">@row.Player.DisplayName</th><td>@row.Player.TotalScore</td>
                <td>@row.Player.Level</td><td>@row.Player.TotalExp</td><td>@row.Player.Wins</td>
                <td>@row.Player.Losses</td><td>@row.Player.TotalMatches</td><td>@row.Player.WinRate.ToString("0.##%")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

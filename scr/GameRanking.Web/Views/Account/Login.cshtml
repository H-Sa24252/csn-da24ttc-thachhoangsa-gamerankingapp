@model LoginInput
@{
    ViewData["Title"] = "Đăng nhập";
}
<h1>Đăng nhập</h1>
<form asp-action="Login" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control mb-3" autocomplete="username" />
    <label asp-for="Password" class="form-label">Mật khẩu</label>
    <input asp-for="Password" class="form-control mb-3" autocomplete="current-password" />
    <button type="submit" class="btn btn-primary">Đăng nhập</button>
</form>
